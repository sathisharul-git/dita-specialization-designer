<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ditadesigner.ui.MainController"
            prefWidth="1280" prefHeight="800">

    <!-- ═══════════════ TOP: MenuBar + ToolBar ═══════════════ -->
    <top>
        <VBox>
            <MenuBar fx:id="menuBar" useSystemMenuBar="false">
                <Menu text="File">
                    <MenuItem text="New Project"        onAction="#onNewProject"     accelerator="Ctrl+N"/>
                    <MenuItem text="Open Project..."    onAction="#onOpenProject"    accelerator="Ctrl+O"/>
                    <MenuItem text="Save Project"       onAction="#onSaveProject"    accelerator="Ctrl+S"/>
                    <MenuItem text="Save Project As..."  onAction="#onSaveProjectAs"/>
                    <SeparatorMenuItem/>
                    <Menu fx:id="recentProjectsMenu" text="Recent Projects" disable="true"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Project Metadata..." onAction="#onProjectMetadata"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Export ZIP..."      onAction="#onExportZip"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Exit"               onAction="#onExit"/>
                </Menu>
                <Menu text="DITA">
                    <MenuItem text="Load DITA Libraries..."  onAction="#onLoadDitaLibraries"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Generate DTD"            onAction="#onGenerateDtd"/>
                    <MenuItem text="Generate XSD"            onAction="#onGenerateXsd"/>
                    <MenuItem text="Generate XML Catalog"    onAction="#onGenerateCatalog"/>
                    <MenuItem text="Generate All"            onAction="#onGenerateAll"   accelerator="Ctrl+G"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Validate Model"          onAction="#onValidateModel"/>
                </Menu>
                <Menu text="Edit">
                    <MenuItem text="Undo"               onAction="#onUndo"           accelerator="Ctrl+Z"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Select All"         onAction="#onSelectAll"      accelerator="Ctrl+A"/>
                    <MenuItem text="Delete Selected"    onAction="#onDeleteSelected" accelerator="Delete"/>
                </Menu>
                <Menu text="View">
                    <MenuItem text="Zoom In"            onAction="#onZoomIn"         accelerator="Ctrl+EQUALS"/>
                    <MenuItem text="Zoom Out"           onAction="#onZoomOut"        accelerator="Ctrl+MINUS"/>
                    <MenuItem text="Reset Zoom"         onAction="#onZoomReset"      accelerator="Ctrl+DIGIT0"/>
                    <MenuItem text="Fit to Screen"      onAction="#onFitScreen"/>
                </Menu>
                <Menu text="Help">
                    <MenuItem text="Keyboard Shortcuts" onAction="#onKeyboardShortcuts" accelerator="F1"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="About"              onAction="#onAbout"/>
                </Menu>
            </MenuBar>

            <ToolBar>
                <Button text="New"          onAction="#onNewProject"      styleClass="toolbar-btn"/>
                <Button text="Open"         onAction="#onOpenProject"     styleClass="toolbar-btn"/>
                <Button text="Save"         onAction="#onSaveProject"     styleClass="toolbar-btn"/>
                <Separator/>
                <Button text="Generate DTD"   onAction="#onGenerateDtd"    styleClass="toolbar-btn,gen-btn"/>
                <Button text="Generate XSD"   onAction="#onGenerateXsd"    styleClass="toolbar-btn,gen-btn"/>
                <Button text="Generate All"   onAction="#onGenerateAll"    styleClass="toolbar-btn,gen-btn-primary"/>
                <Separator/>
                <Button text="Load DITA Libs" onAction="#onLoadDitaLibraries" styleClass="toolbar-btn"/>
                <Separator/>
                <Button text="⊡ Fit"        onAction="#onFitScreen"      styleClass="toolbar-btn"/>
                <Button text="＋"           onAction="#onZoomIn"          styleClass="toolbar-btn"/>
                <Label fx:id="zoomLabel"    text="100%" style="-fx-font-size:11px; -fx-min-width:38;"/>
                <Button text="－"           onAction="#onZoomOut"         styleClass="toolbar-btn"/>
            </ToolBar>
        </VBox>
    </top>

    <!-- ═══════════════ LEFT: Toolbox ═══════════════ -->
    <left>
        <VBox styleClass="toolbox" prefWidth="165" spacing="2">
            <padding><Insets top="6" right="4" bottom="6" left="4"/></padding>

            <Label text="Toolbox" styleClass="panel-title"/>
            <Separator/>

            <Label text="Add Nodes" styleClass="section-label"/>

            <ToggleButton fx:id="btnAddTopicType"   text="⬛ Topic Type"  maxWidth="Infinity"
                         onAction="#onToolTopicType"  styleClass="tool-btn"/>
            <ToggleButton fx:id="btnAddElement"     text="◻ Element"      maxWidth="Infinity"
                         onAction="#onToolElement"    styleClass="tool-btn"/>
            <ToggleButton fx:id="btnAddDomain"      text="◈ Domain"       maxWidth="Infinity"
                         onAction="#onToolDomain"     styleClass="tool-btn"/>

            <Separator/>
            <Label text="Connect" styleClass="section-label"/>

            <ToggleButton fx:id="btnConnectInherit" text="↑ Inheritance"  maxWidth="Infinity"
                         onAction="#onToolConnectInherit" styleClass="tool-btn"/>
            <ToggleButton fx:id="btnConnectContain" text="↓ Containment"  maxWidth="Infinity"
                         onAction="#onToolConnectContain" styleClass="tool-btn"/>

            <Separator/>

            <ToggleButton fx:id="btnSelect"         text="✦ Select / Move" maxWidth="Infinity"
                         onAction="#onToolSelect"    styleClass="tool-btn" selected="true"/>

            <Separator/>
            <Label text="Samples" styleClass="section-label"/>

            <Button text="phxTask Sample" maxWidth="Infinity"
                    onAction="#onAddSample" styleClass="sample-btn"/>

            <Separator/>
            <Label text="Actions" styleClass="section-label"/>

            <Button text="Validate"  maxWidth="Infinity"
                    onAction="#onValidateModel"
                    style="-fx-background-color: #c0392b; -fx-text-fill: white;
                           -fx-border-radius: 4; -fx-background-radius: 4;
                           -fx-cursor: hand; -fx-padding: 5 8 5 8; -fx-font-size: 11px;"/>
        </VBox>
    </left>

    <!-- ═══════════════ CENTER: Canvas ═══════════════ -->
    <center>
        <ScrollPane fx:id="canvasScrollPane"
                    pannable="false"
                    fitToWidth="false"
                    fitToHeight="false"
                    styleClass="canvas-scroll">
            <Pane fx:id="canvas"
                  prefWidth="2400" prefHeight="1800"
                  styleClass="canvas-pane"/>
        </ScrollPane>
    </center>

    <!-- ═══════════════ RIGHT: Properties Panel ═══════════════ -->
    <right>
        <ScrollPane prefWidth="290" fitToWidth="true" hbarPolicy="NEVER">
            <VBox fx:id="propertiesPanel" styleClass="props-panel" spacing="4">
                <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
                <Label text="Properties" styleClass="panel-title"/>
                <Separator/>
                <Label fx:id="propertiesPlaceholder"
                       text="Select a node to edit properties."
                       wrapText="true" styleClass="placeholder-label"/>
            </VBox>
        </ScrollPane>
    </right>

    <!-- ═══════════════ BOTTOM: Log + Status Bar ═══════════════ -->
    <bottom>
        <VBox>
            <Separator/>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <padding><Insets top="2" right="6" bottom="2" left="6"/></padding>
                <Label text="Console" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
                <Button text="Clear" onAction="#onClearLog"
                        style="-fx-font-size: 10px; -fx-padding: 1 6 1 6;"/>
            </HBox>
            <TextArea fx:id="logArea"
                      editable="false"
                      prefHeight="120"
                      wrapText="true"
                      styleClass="log-area"/>
            <HBox styleClass="status-bar">
                <padding><Insets top="3" right="8" bottom="3" left="8"/></padding>
                <Label fx:id="statusLabel" text="Ready" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
